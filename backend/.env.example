# Copy to .env and fill in. Never commit .env.

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ZeroTrace?retryWrites=true&w=majority

# 256-bit AES key, 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Origin of the frontend, used for CORS (no trailing slash)
REACT_APP_API_URL=http://localhost:3000

# Google OAuth client id. The server uses it to confirm sign-in tokens were issued to your app.
GOOGLE_CLIENT_ID=

# Optional
PORT=5000
# Comma-separated DNS servers. Fixes "querySrv ECONNREFUSED" for mongodb+srv:// on some networks.
# DNS_SERVERS=8.8.8.8,1.1.1.1
