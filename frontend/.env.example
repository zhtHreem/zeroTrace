# Copy to .env and fill in.

# Where the backend API lives (no trailing slash)
REACT_APP_LOCAL_URL=http://localhost:5000

# Google OAuth client id (public by design; add http://localhost:3000 as an authorised JavaScript origin)
REACT_APP_GOOGLE_CLIENT_ID=

# Optional: your own reCAPTCHA v2 site key
# REACT_APP_RECAPTCHA_SITE_KEY=

# Faster dev builds
GENERATE_SOURCEMAP=false
